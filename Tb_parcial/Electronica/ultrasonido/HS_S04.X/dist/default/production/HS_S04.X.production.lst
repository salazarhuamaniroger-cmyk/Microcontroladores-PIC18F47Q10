  2965                           ;	XINST = OFF, Extended Instruction Set and Indexed Addressing Mode disabled
  2966   300003                     	org	3145731
  2967   300003  FF                 	db	255
  2968                           
  2969                           ;Config register CONFIG3L @ 0x300004
  2970                           ;	WDT Period Select bits
