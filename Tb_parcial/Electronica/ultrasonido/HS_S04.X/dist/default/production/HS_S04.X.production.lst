  2925                           ;Config register CONFIG1L @ 0x300000
  2926                           ;	External Oscillator mode Selection bits
  2927                           ;	FEXTOSC = ECH, EC (external clock) above 8 MHz; PFM set to high power
  2928                           ;	Power-up default value for COSC bits
  2929                           ;	RSTOSC = EXTOSC, EXTOSC operating per FEXTOSC bits (device manufacturing default)
  2930   300000                     	org	3145728
  2931   300000  FF                 	db	255
  2932                           
  2933                           ;Config register CONFIG1H @ 0x300001
  2934                           ;	Clock Out Enable bit
  2935                           ;	CLKOUTEN = OFF, CLKOUT function is disabled
  2936                           ;	Clock Switch Enable bit
  2937                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
  2938                           ;	Fail-Safe Clock Monitor Enable bit
  2939                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
  2940   300001                     	org	3145729
  2941   300001  FF                 	db	255
  2942                           
  2943                           ;Config register CONFIG2L @ 0x300002
  2944                           ;	Master Clear Enable bit
  2945                           ;	MCLRE = EXTMCLR, MCLR pin (RE3) is MCLR
  2946                           ;	Power-up Timer Enable bit
  2947                           ;	PWRTE = ON, Power up timer enabled
  2948                           ;	Low-power BOR enable bit
  2949                           ;	LPBOREN = OFF, Low power BOR is disabled
  2950                           ;	Brown-out Reset Enable bits
  2951                           ;	BOREN = OFF, Brown-out Reset disabled
  2952   300002                     	org	3145730
  2953   300002  3D                 	db	61
  2954                           
  2955                           ;Config register CONFIG2H @ 0x300003
  2956                           ;	Brown Out Reset Voltage selection bits
  2957                           ;	BORV = VBOR_190, Brown-out Reset Voltage (VBOR) set to 1.90V
  2958                           ;	ZCD Disable bit
  2959                           ;	ZCD = OFF, ZCD disabled. ZCD can be enabled by setting the ZCDSEN bit of ZCDCON
  2960                           ;	PPSLOCK bit One-Way Set Enable bit
  2961                           ;	PPS1WAY = ON, PPSLOCK bit can be cleared and set only once; PPS registers remain locke
      +                          d after one clear/set cycle
  2962                           ;	Stack Full/Underflow Reset Enable bit
  2963                           ;	STVREN = ON, Stack full/underflow will cause Reset
