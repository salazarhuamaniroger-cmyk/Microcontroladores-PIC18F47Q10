  2917                           
  2918                           ;Config register CONFIG1L @ 0x300000
  2919                           ;	External Oscillator mode Selection bits
  2920                           ;	FEXTOSC = ECH, EC (external clock) above 8 MHz; PFM set to high power
  2921                           ;	Power-up default value for COSC bits
  2922                           ;	RSTOSC = EXTOSC, EXTOSC operating per FEXTOSC bits (device manufacturing default)
  2923   300000                     	org	3145728
  2924   300000  FF                 	db	255
  2925                           
  2926                           ;Config register CONFIG1H @ 0x300001
  2927                           ;	Clock Out Enable bit
  2928                           ;	CLKOUTEN = OFF, CLKOUT function is disabled
  2929                           ;	Clock Switch Enable bit
  2930                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
  2931                           ;	Fail-Safe Clock Monitor Enable bit
  2932                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
  2933   300001                     	org	3145729
  2934   300001  FF                 	db	255
  2935                           
  2936                           ;Config register CONFIG2L @ 0x300002
  2937                           ;	Master Clear Enable bit
  2938                           ;	MCLRE = EXTMCLR, MCLR pin (RE3) is MCLR
  2939                           ;	Power-up Timer Enable bit
  2940                           ;	PWRTE = ON, Power up timer enabled
  2941                           ;	Low-power BOR enable bit
  2942                           ;	LPBOREN = OFF, Low power BOR is disabled
  2943                           ;	Brown-out Reset Enable bits
  2944                           ;	BOREN = OFF, Brown-out Reset disabled
  2945   300002                     	org	3145730
  2946   300002  3D                 	db	61
  2947                           
  2948                           ;Config register CONFIG2H @ 0x300003
  2949                           ;	Brown Out Reset Voltage selection bits
  2950                           ;	BORV = VBOR_190, Brown-out Reset Voltage (VBOR) set to 1.90V
  2951                           ;	ZCD Disable bit
  2952                           ;	ZCD = OFF, ZCD disabled. ZCD can be enabled by setting the ZCDSEN bit of ZCDCON
  2953                           ;	PPSLOCK bit One-Way Set Enable bit
  2954                           ;	PPS1WAY = ON, PPSLOCK bit can be cleared and set only once; PPS registers remain locke
      +                          d after one clear/set cycle
  2955                           ;	Stack Full/Underflow Reset Enable bit
  2956                           ;	STVREN = ON, Stack full/underflow will cause Reset
  2957                           ;	Extended Instruction Set Enable bit
  2958                           ;	XINST = OFF, Extended Instruction Set and Indexed Addressing Mode disabled
  2959   300003                     	org	3145731
  2960   300003  FF                 	db	255
  2961                           
  2962                           ;Config register CONFIG3L @ 0x300004
  2963                           ;	WDT Period Select bits
  2964                           ;	WDTCPS = WDTCPS_31, Divider ratio 1:65536; software control of WDTPS
  2965                           ;	WDT operating mode
  2966                           ;	WDTE = OFF, WDT Disabled
  2967   300004                     	org	3145732
  2968   300004  9F                 	db	159
  2969                           
  2970                           ;Config register CONFIG3H @ 0x300005
  2971                           ;	WDT Window Select bits
  2972                           ;	WDTCWS = WDTCWS_7, window always open (100%); software control; keyed access not requi
      +                          red
  2973                           ;	WDT input clock selector
